{
    "name": "php-framework/logging",
    "description": "Structured JSON logging for Yasno PHP projects: Monolog factory, request id, PSR-15 middleware, Symfony bridge.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/MikcleGrok/php-logging",
    "support": {
        "source": "https://github.com/MikcleGrok/php-logging",
        "issues": "https://github.com/MikcleGrok/php-logging/issues"
    },
    "authors": [
        { "name": "Sergey" }
    ],
    "require": {
        "php": ">=8.2",
        "monolog/monolog": "^3",
        "psr/http-server-middleware": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "symfony/http-kernel": "^7.2",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "symfony/http-kernel": "Required for Yasno\\Logging\\Bridge\\Symfony\\RequestIdSubscriber"
    },
    "autoload": {
        "psr-4": {
            "Yasno\\Logging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yasno\\Logging\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
